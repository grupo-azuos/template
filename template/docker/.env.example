# Unir às variáveis do server (ou substituir server pelo site estático no brand).
# Prod e Staging são exports separados no Komodo. Nunca copiar credenciais entre eles.
# Este arquivo não é lido automaticamente: cadastre os valores no Infisical.
NODE_ENV=production
APP_ENV=staging
PUBLIC_DOMAIN=template.homo.grupoazuos.com.br
APP_REPLICAS=1
APP_CPU_LIMIT=1.0
APP_CPU_RESERVATION=0.10
APP_MEMORY_LIMIT=512M
APP_MEMORY_RESERVATION=128M
DATABASE_POOL_SIZE=5
DATABASE_MIGRATE_ON_START=false
TRUST_PROXY_HOPS=3
# No core/Prod são 2 saltos; no homo/Staging são 3 (ops, Caddy local e gateway).
# Origem alcançável pelo gateway, sem /api; o hostname deve corresponder ao issuer.
ADMIN_CONSOLE_URL=https://login.homo.grupoazuos.com.br
# ADMIN_CONSOLE_CLIENT_SECRET=um_template_SECRETO_DO_AMBIENTE
# PostgreSQL e Valkey deste ambiente; o core usa os seus próprios valores em Prod.
# DATABASE_URL=postgresql://template:SEGREDO@postgres.staging.internal:5432/apps
# DATABASE_MIGRATION_URL=postgresql://APP_MIGRATOR:SEGREDO@postgres.staging.internal:5432/apps
# VALKEY_URL=redis://template:SEGREDO@100.85.230.136:6379/0
VALKEY_KEY_PREFIX=template:staging:
VALKEY_TIMEOUT_MS=1000

# Borda de Staging no NetBird (ops); em Prod use o IP VPN da borda do core.
APP_EDGE_VPN_IP=DEFINIR_IP_NETBIRD_DA_BORDA_DESTE_AMBIENTE

# Origens públicas para links/callbacks. Em Prod remover .homo. do hostname.
API_PUBLIC_URL=https://template.homo.grupoazuos.com.br
APP_PUBLIC_URL=https://template.homo.grupoazuos.com.br
API_CORS_ORIGIN=https://template.homo.grupoazuos.com.br

DEPLOY_DOMAIN=homo.grupoazuos.com.br
