# syntax=docker/dockerfile:1
FROM node:24.21.0-bookworm-slim AS deps
WORKDIR /repo
COPY package.json package-lock.json ./
COPY shared/package.json shared/package.json
COPY server/package.json server/package.json
COPY client/package.json client/package.json
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --no-audit --no-fund

# SQLite existe somente no MVP. Compilar o módulo nativo sem levar toolchain ao runtime.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && npm rebuild better-sqlite3 \
  && rm -rf /var/lib/apt/lists/*

# Rspack empacota o server num arquivo só (shared e bibliotecas dentro) e o Rsbuild gera o client.
FROM deps AS build
COPY . .
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Runtime sem node_modules: só o pacote do server, as migrations e o client.
FROM node:24.21.0-bookworm-slim AS app
WORKDIR /repo
ENV NODE_ENV=production API_PORT=3000
COPY --from=build --chown=node:node /repo/server/package.json server/package.json
COPY --from=build --chown=node:node /repo/server/dist server/dist
COPY --from=build --chown=node:node /repo/server/drizzle server/drizzle
COPY --from=build --chown=node:node /repo/client/dist client/dist
# Módulo nativo do SQLite do MVP: fica fora do pacote do Rspack. Sai junto com o SQLite na promoção.
COPY --from=deps --chown=node:node /repo/node_modules/better-sqlite3 node_modules/better-sqlite3
COPY --from=deps --chown=node:node /repo/node_modules/bindings node_modules/bindings
COPY --from=deps --chown=node:node /repo/node_modules/file-uri-to-path node_modules/file-uri-to-path
RUN mkdir -p /repo/server/data && chown node:node /repo/server/data
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=45s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/api/health',{signal:AbortSignal.timeout(3000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/dist/main.js"]
